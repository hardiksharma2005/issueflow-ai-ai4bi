# IssueFlow AI — environment variables
# Copy to .env.local for local development. Never commit real values.

# --- Supabase (required) ------------------------------------------------------
# Supabase dashboard → Project Settings → API (free tier, no credit card).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Browser-safe key: the legacy "anon" key or the newer "publishable" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row Level Security: used for cron jobs, inviting users and seeding.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Postgres connection string, only needed by `npm run db:migrate`
# (Project Settings → Database → Connection string → URI, session pooler is fine).
SUPABASE_DB_URL=

# Public URL of the app — used in auth email links (sign-up confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider ----------------------------------------------------------------
# "mock" (default): free, deterministic, no API key, results labelled "Simulated".
# "grok": calls the xAI API (billed per token by xAI — see docs/05-ai-integration.md).
AI_PROVIDER=mock
XAI_API_KEY=
XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1

# --- Scheduled automations ---------------------------------------------------------
# Random string (min 16 chars). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Demo data -----------------------------------------------------------------------
# Password given to the demo users created by `npm run db:seed` (min 8 characters).
DEMO_PASSWORD=
