# IssueFlow AI — environment variables
# Copy to .env.local for local development. Never commit real values.

# --- Supabase (required) ------------------------------------------------------
# Supabase dashboard → Project Settings → API (free tier, no credit card).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Browser-safe key: the legacy "anon" key or the newer "publishable" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row Level Security: used for cron jobs, inviting users and seeding.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Postgres connection string, only needed by `npm run db:migrate`
# (Project Settings → Database → Connection string → URI, session pooler is fine).
SUPABASE_DB_URL=

# Public URL of the app — used in auth email links (sign-up confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Time zone for displaying dates and for "today"/overdue (IANA name). Default: Asia/Kolkata.
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# --- AI provider ----------------------------------------------------------------
# "mock" (default): free, deterministic, no API key, results labelled "Simulated".
# "groq": GroqCloud (console.groq.com) — free plan with rate limits, text only. Keys start with gsk_.
# "grok": xAI Grok (console.x.ai) — billed per token, reads screenshots. Keys start with xai-.
# Groq and Grok are different companies: put each key in its own variable.
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=
XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1

# --- Scheduled automations ---------------------------------------------------------
# Random string (min 16 chars). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Demo data -----------------------------------------------------------------------
# Password given to the demo users created by `npm run db:seed` (min 8 characters).
DEMO_PASSWORD=
